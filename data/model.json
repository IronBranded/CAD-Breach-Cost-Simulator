{
  "$comment": "Every number the simulator uses. Each entry has v (value) and src (ids from 'sources'); source titles live in i18n/*.json under 'sources'. 'author' = author estimate without an external citation. Values tagged with a citation plus 'author' are author estimates calibrated against that source.",
  "version": "2026.11",
  "currency": "CAD",

  "sources": {
    "author": {},
    "ibm2025": { "url": "https://canada.newsroom.ibm.com/2025-07-30-IBM-Report-Canadians-Data-Security-Under-Increased-Threat,-While-Breach-Costs-Surge" },
    "ibm2025global": { "url": "https://www.infosecurity-magazine.com/news/data-breach-costs-fall/" },
    "sophos2025": { "url": "https://www.sophos.com/en-us/press/press-releases/2025/06/nearly-half-companies-opt-pay-ransom-sophos-report-finds" },
    "cccsNcta2025": { "url": "https://www.canada.ca/en/communications-security/news/2024/10/canadian-centre-for-cyber-security-releases-national-cyber-threat-assessment-2025-2026.html" },
    "desjardins2022": { "url": "https://montreal.ctvnews.ca/200-million-settlement-approved-in-desjardins-personal-information-leak-1.5952935" },
    "lifelabs2023": { "url": "https://bc.ctvnews.ca/maximum-payout-for-lifelabs-class-action-drops-from-150-estimate-to-7-86-1.6886594" },
    "loi25": {},
    "qcIncidents": { "url": "https://www.legisquebec.gouv.qc.ca/en/document/cr/A-2.1,%20r.%203.1" },
    "phipa": { "url": "https://www.ipc.on.ca/en/node/2476" },
    "onFippa2025": { "url": "https://www.ipc.on.ca/en/node/5061" },
    "bcFippa2023": { "url": "https://www.mccarthy.ca/en/insights/blogs/techlex/bc-fippas-mandatory-privacy-breach-notification-and-privacy-management-program-obligations-start-february-1-2023" },
    "abPopa2025": { "url": "https://oipc.ab.ca/legislation/popa/" },
    "privacyActFed": { "url": "https://priv.gc.ca/en/report-a-concern/report-a-privacy-breach-at-your-organization/report-a-privacy-breach-at-your-federal-institution" },
    "pipeda": {},
    "opc": {},
    "osfiB13": {},
    "edelmanTrust": {}
  },

  "rates": {
    "incidentResponse": { "v": 375, "unit": "perHour", "src": ["author"] },
    "forensics":        { "v": 430, "unit": "perHour", "src": ["author"] },
    "breachCounsel":    { "v": 700, "unit": "perHour", "src": ["author"] },
    "itRecovery":       { "v": 175, "unit": "perHour", "src": ["author"] }
  },

  "effort": {
    "forensicHoursPerIrHour": { "v": 0.45, "unit": "ratio", "src": ["author"] },
    "itHoursPerIrHour":       { "v": 2.0,  "unit": "ratio", "src": ["author"] }
  },

  "causes": {
    "src": ["author"],
    "v": {
      "phishing":   { "irMult": 1.0,  "forensicsMult": 1.0 },
      "vuln":       { "irMult": 1.25, "forensicsMult": 1.0 },
      "thirdParty": { "irMult": 1.0,  "forensicsMult": 1.45 }
    }
  },

  "scale": {
    "$comment": "Size anchors. Effort, counsel hours, remediation and extortion amounts are interpolated on a log scale between anchors (clamped outside them). Size = employees when given, otherwise annual revenue.",
    "src": ["author"],
    "v": {
      "revenue":       [1000000, 5000000, 50000000, 500000000],
      "employees":     [10, 50, 300, 3000],
      "irEffort":      [0.5, 1.8, 6.0, 10.5],
      "counselEffort": [0.5, 1.8, 6.0, 15.0],
      "remediation":   [8000, 35000, 180000, 650000]
    }
  },

  "incidents": {
    "$comment": "dataExposure: always | optional (user confirms) | never. operationsImpact = share of operations disrupted during downtimeDays. extortion = amount at each scale.revenue anchor.",
    "src": ["author", "sophos2025"],
    "v": {
      "Ransomware": { "downtimeDays": 10,  "operationsImpact": 0.7, "irHours": 140, "counselHours": 50,  "dataExposure": "optional", "exposureIsDoubleExtortion": true, "ransomDecision": true, "extortion": [40000, 150000, 400000, 1400000] },
      "BEC":        { "downtimeDays": 4,   "operationsImpact": 0.1, "irHours": 40,  "counselHours": 25,  "dataExposure": "optional", "fraudRecovery": true, "extortion": [55000, 165000, 420000, 1100000] },
      "DataBreach": { "downtimeDays": 2,   "operationsImpact": 0.1, "irHours": 100, "counselHours": 180, "dataExposure": "always", "extortion": null },
      "Insider":    { "downtimeDays": 5,   "operationsImpact": 0.2, "irHours": 60,  "counselHours": 30,  "dataExposure": "always", "extortion": null },
      "DoS":        { "downtimeDays": 0.5, "operationsImpact": 0.8, "irHours": 30,  "counselHours": 15,  "dataExposure": "never", "extortion": null }
    }
  },

  "decisions": {
    "$comment": "Not paying a ransom: longer disruption and more rebuild work, unless immutable backups are in place. Fast reporting of a fraudulent transfer: share of BEC funds recovered.",
    "src": ["author", "sophos2025"],
    "v": {
      "unpaidDowntimeMult": 1.5,
      "unpaidDowntimeMultWithBackups": 1.0,
      "unpaidItRecoveryMult": 1.3,
      "becRecoveredShareIfReportedFast": 0.35
    }
  },

  "businessInterruption": {
    "$comment": "Operations loss = annual revenue / 365 x downtime days x incident operationsImpact x industry revenueAtRisk x (1 + extraCostRate).",
    "v": { "extraCostRate": 0.25 },
    "src": ["author"]
  },

  "industries": {
    "$comment": "revenueAtRisk: share of daily revenue lost while operations are disrupted. defaultSector and impliesPhi only pre-fill the form.",
    "src": ["author"],
    "v": {
      "edu":     { "revenueAtRisk": 0.35, "defaultSector": "public" },
      "energy":  { "revenueAtRisk": 0.85 },
      "finance": { "revenueAtRisk": 0.9 },
      "gov":     { "revenueAtRisk": 0.3, "defaultSector": "public" },
      "health":  { "revenueAtRisk": 0.6, "impliesPhi": true },
      "legal":   { "revenueAtRisk": 0.75 },
      "mfg":     { "revenueAtRisk": 0.85 },
      "retail":  { "revenueAtRisk": 0.9 },
      "telco":   { "revenueAtRisk": 0.85 },
      "tech":    { "revenueAtRisk": 0.9 }
    }
  },

  "records": {
    "$comment": "One representative count of affected individuals per bucket (approximate midpoint; 50k+ assumes 100,000). defenceCost = class-action defence spend if a claim is filed.",
    "src": ["author"],
    "v": {
      "Low":      { "individuals": 800,    "classActionProb": 0,    "classActionProbSensitive": 0,    "defenceCost": 0 },
      "Medium":   { "individuals": 5000,   "classActionProb": 0,    "classActionProbSensitive": 0.15, "defenceCost": 150000 },
      "High":     { "individuals": 30000,  "classActionProb": 0.35, "classActionProbSensitive": 0.35, "defenceCost": 300000 },
      "Critical": { "individuals": 100000, "classActionProb": 0.70, "classActionProbSensitive": 0.70, "defenceCost": 600000 }
    }
  },

  "notification": {
    "baseRatePerIndividual":    { "v": 12,  "unit": "perIndividual", "src": ["author"] },
    "doubleExtortionSurcharge": { "v": 0.5, "unit": "ratio",         "src": ["author"] },
    "creditMonitoring":         { "v": { "standard": 35, "phi": 65 }, "unit": "perIndividual", "src": ["author"] }
  },

  "settlement": {
    "$comment": "Calibration: Desjardins (2022) up to $200.85M for ~9.7M people = ~$20.7 per affected person, incl. 5 years of credit monitoring; LifeLabs (2023) up to $9.8M for ~8.6M people = ~$1.14 per affected person. Base + finance premium ~ Desjardins; the uncertainty range spans LifeLabs.",
    "v": { "basePerIndividual": 5, "phiPremium": 5, "financePremium": 15 },
    "unit": "perIndividual",
    "src": ["author", "desjardins2022", "lifelabs2023"]
  },

  "regimes": {
    "$comment": "Expected fine = amount x probability. Private sector: FED + finance/telco resolves to FIN. Public bodies: no monetary penalty is modelled; notification duties and class actions still apply.",
    "src": ["author", "loi25", "pipeda", "phipa", "osfiB13", "opc", "qcIncidents", "onFippa2025", "bcFippa2023", "abPopa2025", "privacyActFed"],
    "federalFinancialIndustries": ["finance", "telco"],
    "v": {
      "QC":        { "sector": "private", "fine": { "type": "revenuePct", "pct": 0.005, "pctPhi": 0.015, "capFixed": 25000000, "capRevenuePct": 0.04, "probability": 0.25 } },
      "ON":        { "sector": "private", "fine": { "type": "fixed", "amount": 50000,  "amountPhi": 150000, "probability": 0.05 } },
      "AB":        { "sector": "private", "fine": { "type": "fixed", "amount": 50000,  "amountPhi": 150000, "probability": 0.05 } },
      "BC":        { "sector": "private", "fine": { "type": "fixed", "amount": 50000,  "amountPhi": 150000, "probability": 0.05 } },
      "OTHER":     { "sector": "private", "fine": { "type": "fixed", "amount": 50000,  "amountPhi": 150000, "probability": 0.05 } },
      "FED":       { "sector": "private", "fine": { "type": "fixed", "amount": 50000,  "amountPhi": 150000, "probability": 0.05 } },
      "FIN":       { "sector": "private", "fine": { "type": "fixed", "amount": 500000, "amountPhi": 500000, "probability": 0.20 } },
      "QC_PUB":    { "sector": "public", "fine": { "type": "none" } },
      "ON_PUB":    { "sector": "public", "fine": { "type": "none" } },
      "AB_PUB":    { "sector": "public", "fine": { "type": "none" } },
      "BC_PUB":    { "sector": "public", "fine": { "type": "none" } },
      "OTHER_PUB": { "sector": "public", "fine": { "type": "none" } },
      "FED_PUB":   { "sector": "public", "fine": { "type": "none" } }
    }
  },

  "controls": {
    "$comment": "Multipliers applied when a control is in place. appliesTo limits a control to some incidents (all when absent). IBM Canada 2025: CA$5.19M average with extensive security AI & automation vs CA$8.53M without; the model applies a smaller, effort-only reduction.",
    "src": ["author", "ibm2025"],
    "v": {
      "automation": { "irEffort": 0.8, "downtime": 0.8 },
      "backups":    { "downtime": 0.6, "itRecovery": 0.7, "appliesTo": ["Ransomware", "Insider"] },
      "retainer":   { "rates": 0.85, "irEffort": 0.9 },
      "irPlan":     { "irEffort": 0.9, "counsel": 0.85, "downtime": 0.9 },
      "encryption": { "individuals": 0.5 }
    }
  },

  "insurance": {
    "$comment": "premiumRateOfLimit is used only when no current premium is entered. Panel rates apply to IR, forensics and counsel when a policy is in place.",
    "v": { "premiumRateOfLimit": 0.03, "postClaimIncrease": 0.40, "increaseYears": 3, "defaultWaitingHours": 12, "panelRateDiscount": 0.85 },
    "src": ["author"]
  },

  "benchmark": {
    "averageBreachCost": { "v": 6980000, "unit": "amount", "src": ["ibm2025"] },
    "severityTiers": {
      "$comment": "Tier thresholds as net exposure (after insurance) / annual revenue.",
      "v": { "medium": 0.02, "high": 0.10, "critical": 0.25 },
      "src": ["author"]
    }
  },

  "uncertainty": {
    "$comment": "Monte Carlo: triangular multipliers (mode 1 = the point estimate) per driver; fines and class actions are drawn as events with the regime / bucket probability. Downtime high end reflects Sophos 2025 (18% took over a month to recover); settlement low end reflects LifeLabs.",
    "src": ["author", "sophos2025", "lifelabs2023"],
    "runs": 5000,
    "v": {
      "effort":             { "low": 0.6, "high": 1.8 },
      "downtime":           { "low": 0.4, "high": 3.0 },
      "counsel":            { "low": 0.7, "high": 1.6 },
      "extortion":          { "low": 0.3, "high": 2.5 },
      "unitCosts":          { "low": 0.8, "high": 1.3 },
      "remediation":        { "low": 0.6, "high": 1.6 },
      "fineSeverity":       { "low": 0.2, "high": 3.0 },
      "settlementSeverity": { "low": 0.2, "high": 3.0 },
      "defenceSeverity":    { "low": 0.5, "high": 2.0 }
    }
  },

  "variableX": {
    "weights": {
      "src": ["author", "ibm2025", "edelmanTrust"],
      "v": {
        "Ransomware": { "churn": 0.40, "revenue": 0.30, "recruitment": 0.15, "partner": 0.15 },
        "DataBreach": { "churn": 0.45, "revenue": 0.28, "recruitment": 0.12, "partner": 0.15 },
        "BEC":        { "churn": 0.25, "revenue": 0.35, "recruitment": 0.10, "partner": 0.30 },
        "Insider":    { "churn": 0.30, "revenue": 0.25, "recruitment": 0.30, "partner": 0.15 },
        "DoS":        { "churn": 0.35, "revenue": 0.40, "recruitment": 0.10, "partner": 0.15 }
      }
    },
    "industryShift": {
      "src": ["author"],
      "v": {
        "finance": { "partner": 0.08, "churn": -0.05 },
        "health":  { "churn": 0.08, "partner": -0.05 },
        "retail":  { "churn": 0.10, "revenue": -0.05, "partner": -0.05 },
        "gov":     { "recruitment": 0.10, "churn": -0.05, "partner": -0.05 }
      }
    }
  }
}
